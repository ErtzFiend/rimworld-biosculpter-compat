<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds against the installed RimWorld 1.7.5005 rev1082 managed assemblies.
    Proprietary DLLs are referenced from RIMWORLD_LIBS (outside this repository) and are
    never copied to the output (Private=false).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RimworldBiosculpterCompat</AssemblyName>
    <RootNamespace>RimworldBiosculpterCompat</RootNamespace>
    <Version>1.1.0</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>$(MSBuildThisFileDirectory)../../1.7/Assemblies/</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <RimWorldLibs Condition="'$(RIMWORLD_LIBS)' != ''">$(RIMWORLD_LIBS)</RimWorldLibs>
    <RimWorldLibs Condition="'$(RimWorldLibs)' == ''">/root/rimworld_libs/1.7.5005-rev1082</RimWorldLibs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldLibs)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldLibs)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimWorldLibs)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
